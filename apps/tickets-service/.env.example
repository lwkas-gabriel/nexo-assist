# Copie para .env (o .env nunca é versionado). O `pnpm setup:env` faz isso e gera o token.

# Porta HTTP do serviço de chamados simulado.
PORT=3001

# Banco SQLite do serviço (arquivo local, criado na primeira execução).
DATABASE_URL=file:./data/tickets.db

# Segredo compartilhado com a api: só ela pode chamar este serviço.
# Gerado automaticamente pelo `pnpm setup:env` (o mesmo valor vai para TICKETS_SERVICE_TOKEN da api).
SERVICE_TOKEN=

# Fração das requisições que falham de propósito (0 a 1), simulando o sistema legado instável.
# A api tenta de novo com idempotência; 0 desliga a simulação.
FAILURE_RATE=0.1

# Recria os dados de demonstração a cada inicialização (true no deploy de demonstração).
SEED_ON_START=false
