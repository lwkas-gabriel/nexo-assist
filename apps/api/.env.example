# Copie para .env (o .env nunca é versionado).

# Porta HTTP da api (chat, console e agent).
PORT=3000

# Banco SQLite da api (conversas, mensagens, sessões), criado na primeira execução.
DATABASE_URL=file:./data/api.db

# Cookie de sessão só por HTTPS: true em produção, false no desenvolvimento local (HTTP).
COOKIE_SECURE=false

# Apaga as conversas de demonstração a cada inicialização (true no deploy de demonstração).
SEED_ON_START=false

# Modelo de linguagem do agent (ver docs/decisions/0010-gemini-plano-gratuito.md):
#   gemini → Gemini no plano gratuito do Google (exige GEMINI_API_KEY e LLM_MODEL)
#   mock   → modelo falso roteirizado, sem chave (usado nos testes E2E e no CI)
LLM_MODE=mock

# Chave gratuita do Google AI Studio (aistudio.google.com/apikey). Nunca commite este valor.
GEMINI_API_KEY=
# Id do modelo do Gemini com plano gratuito.
LLM_MODEL=gemini-3.5-flash-lite

# Tetos globais de mensagens ao agent (todos os usuários juntos), dentro da cota do modelo.
# Cota gratuita do gemini-3.5-flash-lite (AI Studio, 30/10/2026): 15 requisições/min e 500/dia.
# Cada mensagem usa até 4 chamadas ao modelo (classificador + até 3 passos do agent):
# 15 / 4 ≈ 3 por minuto; 500 / 4 = 125 por dia (120 com folga).
CHAT_MESSAGES_PER_MINUTE=3
CHAT_MESSAGES_PER_DAY=120

# Serviço de chamados simulado (apps/tickets-service).
TICKETS_SERVICE_URL=http://localhost:3001
# Gerado automaticamente pelo `pnpm setup:env` (o mesmo valor do SERVICE_TOKEN do tickets-service).
TICKETS_SERVICE_TOKEN=
